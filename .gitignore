## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options directory
.vs/

#outputFiles
*.wwwRoot/

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/
artifacts/

# Debug Symbols and Logs
*.pdb
*.log
*.binlog

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Generated log files in wwwRoot (Your custom logs)
wwwRoot/*.txt

# Ignore wwwRoot folders (prevent committing runtime logs)
WebApplication1/wwwRoot/
wwwRoot/

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish Web Output
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
*.publishsettings

# SQL Server local database files (If using EF Core LocalDB)
*.mdf
*.ldf
*.ndf

# Testing & Code Coverage (MSTest, NUnit, Coverlet)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info

# Security (Ignore Certificates)
*.pfx

# ReSharper / Rider (Common .NET IDE tools)
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio cache files
*.[Cc]ache
!?*.[Cc]ache/